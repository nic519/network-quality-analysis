{
  "name": "latency-compass",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:css && electrobun dev",
    "dev:watch": "bun run build:css && electrobun dev --watch",
    "build": "bun run build:css && ELECTROBUN_BUILD_ENV=stable electrobun build --env=stable",
    "build:dev": "bun run build:css && ELECTROBUN_BUILD_ENV=dev electrobun build --env=dev",
    "build:css": "tailwindcss -i src/mainview/src/index.css -o src/mainview/electrobun.css --minify",
    "build:web": "vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrobun": "^1.18.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.6.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
